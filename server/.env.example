# ─── Server ────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS (comma-separated, leave empty for dev) ───────
# In production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# ─── Database ──────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/makeup_roopal_goel

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Admin Credentials ─────────────────────────────────
ADMIN_EMAIL=admin@roopalgoel.com
ADMIN_PASSWORD=ChangeMe123!

# ─── Nodemailer (SMTP) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Contact Email ─────────────────────────────────────
CONTACT_TO_EMAIL=roopal@example.com
CONTACT_FROM_EMAIL=portfolio@roopalgoel.com
